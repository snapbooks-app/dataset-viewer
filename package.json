{
  "name": "dataset-viewer",
  "version": "0.0.5",
  "description": "A viewer for dataset files",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux --mac --win",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "test": "echo \"Error: no test specified\" && exit 1",
    "release": "npm version patch && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snapbooks-app/dataset-viewer.git"
  },
  "keywords": [],
  "author": {
    "name": "Snapbooks",
    "email": "hi@snapbooks.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/snapbooks-app/dataset-viewer/issues"
  },
  "homepage": "https://github.com/snapbooks-app/dataset-viewer#readme",
  "devDependencies": {
    "daisyui": "^3.0.0",
    "electron": "^32.0.1",
    "electron-builder": "^22.11.7",
    "tailwindcss": "^3.3.0"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.0.1",
    "marked": "^5.0.2"
  },
  "build": {
    "appId": "com.snapbooks.datasetviewer",
    "productName": "Dataset Viewer",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
